# Copy this file to server/.env; never commit credentials.
# Generate a secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_random_secret

# Used only when there is no ROOT account. At least 12 characters, max 72 UTF-8 bytes.
ROOT_EMAIL=root@tennis.com
ROOT_PASSWORD=replace_with_a_unique_long_password

# Exact frontend origin, without a trailing slash. Production requires HTTPS.
CORS_ORIGIN=http://localhost:5173
PORT=4000
HOST=127.0.0.1

# Defaults to server/database.sqlite for compatibility with an existing checkout.
# Production: use an absolute path outside the release directory on a persistent disk.
# DATABASE_PATH=/srv/tennis-data/production.sqlite

# Set to loopback only behind a reverse proxy on the same host.
# TRUST_PROXY=loopback
# NODE_ENV=production
